# Non-secret configuration template. Put real values in Railway variables.
# The app reads process environment variables; this file is not loaded automatically.
APP_BASE_URL=https://your-care-service.up.railway.app
DATABASE_URL=
PRACTITIONER_EMAIL=
PRACTITIONER_PASSWORD=
PRACTITIONER_NAME=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PILOT_MODE=false
PILOT_PRICE_CENTS=49900
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENABLED=false
# Explicit environment guard: sandbox requires sk_test_ in production.
BILLING_MODE=sandbox
# Care is now sandbox-only in code. Institute has independent credentials/mode.
INSTITUTE_BILLING_MODE=sandbox
INSTITUTE_STRIPE_TEST_SECRET_KEY=
INSTITUTE_STRIPE_TEST_WEBHOOK_SECRET=
# Production preparation only. Leave blank/off until a separate activation.
INSTITUTE_STRIPE_LIVE_SECRET_KEY=
INSTITUTE_STRIPE_LIVE_WEBHOOK_SECRET=
INSTITUTE_LIVE_PAYMENTS_ENABLED=false
INSTITUTE_LIVE_ONBOARDING_ENABLED=false
INSTITUTE_LIVE_WEBSITE_READY=false
INSTITUTE_GOOGLE_PRODUCTION_READY=false
INSTITUTE_LIVE_TERMS_VERSION=
INSTITUTE_FOUNDATIONS_1_CLASSROOM_ID=
INSTITUTE_FOUNDATIONS_1_ORIENTATION_URL=
INSTITUTE_FOUNDATIONS_1_DETAILS=
INSTITUTE_FOUNDATIONS_1_AUTO_ACCESS_APPROVED=false
# Keep false until schedules, financial terms and enrollment policies are final.
INSTITUTE_LIVE_PAYMENTS_READY=false
# off | sandbox (previews only, no external messages/roster writes) | live
INSTITUTE_AUTOMATION_MODE=off
# Dedicated test class; real diagnostic messages go only to langa@liferx.us.
INSTITUTE_TEST_CLASSROOM_ID=
# Google OAuth web application; configure credentials only in Railway.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTITUTE_WEBSITE_URL=https://shambasana-production.up.railway.app
INSTITUTE_SERVICE_TOKEN=
INSTITUTE_REGISTRATION_OPEN=false
INSTITUTE_FOUNDATIONS_REVIEW_OPEN=false
INSTITUTE_OPEN_COURSES=The Psyche in Chinese Medicine|Advanced Diagnosis & Treatment
